# frontend/.env (optional) — only needed when you deploy
VITE_SERVER_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Code execution (see EXECUTION.md)
#
# Code runs in a REMOTE sandbox. Nothing is compiled on this machine or on the
# server, so no compilers, SDKs, PATH entries or Docker are required anywhere.
#
# Leave everything commented out and SyncSpace falls back to paiza.io, which
# needs no account -- fine for a demo, rate limited and best-effort otherwise.
# For anything you care about, configure Judge0 below.
# ---------------------------------------------------------------------------

# Order in which providers are tried. First one that answers wins.
# EXEC_PROVIDERS=judge0,piston,paiza

# --- Judge0 (recommended) --------------------------------------------------
# Option A - Sulu (judge0.com), 20,000 free submissions on signup:
# JUDGE0_URL=https://judge0-ce.p.sulu.sh
# JUDGE0_KEY=your-sulu-key
#
# Option B - RapidAPI Basic plan (free, 50 runs/day):
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=your-rapidapi-key
#
# Option C - your own instance (docker compose up -d), unlimited:
# JUDGE0_URL=http://localhost:2358
# JUDGE0_KEY=

# --- Piston (only if you self-host it; the public API closed Feb 2026) ------
# PISTON_URL=http://localhost:2000/api/v2

# --- paiza.io fallback ------------------------------------------------------
# PAIZA_ENABLED=false

# --- Limits ------------------------------------------------------------------
# EXEC_RUN_TIMEOUT_MS=8000
# EXEC_MEMORY_KB=128000
# EXEC_MAX_CONCURRENT=8
# EXEC_RATE_MAX=20
# EXEC_LOG=off

# --- Development escape hatch (NOT for a deployed server) -------------------
# Runs code on this machine with local compilers, unsandboxed.
# EXEC_PROVIDERS=local
# EXEC_ALLOW_LOCAL=true

# ---------------------------------------------------------------------------
# SyncSpace AI (see AI_MODULE.md)
#
# The API key lives HERE, in backend/.env, and is read only inside
# services/ai/aiService.js. It is never sent to the browser and never appears
# in an API response. Do not add it to a VITE_ variable — anything prefixed
# VITE_ is compiled into the frontend bundle and is public.
# ---------------------------------------------------------------------------

# Required. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here

# --- Model tiers ------------------------------------------------------------
# Simple work (chat, generate, tests, document) uses the FAST model; work where
# being wrong costs more than being slow (debug, error, optimize, convert, and
# any large payload) uses the SMART model. Defaults shown.
# AI_MODEL_FAST=gemini-3.5-flash-lite
# AI_MODEL_SMART=gemini-3.6-flash

# Pin ONE model for every request, overriding both tiers above. Useful for
# A/B testing a new model; leave unset in normal use.
# GEMINI_MODEL=

# --- Thinking level ---------------------------------------------------------
# THE dominant latency control. Gemini 3.x models reason before they answer,
# and 3.6/3.7 Flash default to `medium` — which is why an unconfigured setup
# feels like it hangs. Allowed: minimal | low | medium | high.
# (3.7 Flash does not accept `minimal`; the code raises it to `low` for you.)
# AI_THINKING_FAST=minimal
# AI_THINKING_SMART=low

# --- Timeouts and limits ----------------------------------------------------
# AI_TIMEOUT_MS=60000          whole-generation ceiling
# AI_STALL_TIMEOUT_MS=20000    give up if the provider goes quiet mid-stream
# AI_RATE_MAX=20               requests per user per window
# AI_RATE_WINDOW_MS=60000

# NOTE: temperature / top_p / top_k are deliberately NOT sent. Google deprecated
# them for Gemini 3.x and they are ignored by the API. Output shape is
# controlled through the system instruction and thinking level instead.
