# ===========================================================================
#  backend/.env  —  SERVER-SIDE configuration
#
#  Copy this file to `backend\.env` and fill in what you need.
#  dev.bat does that copy for you if the file is missing.
#
#  Everything here stays on the server. It is never compiled into the
#  frontend and never sent to a browser. Secrets belong in THIS file, not
#  in frontend/.env.
#
#  `.env` is gitignored, which is why it is not in the repository — and why
#  it can go missing when the project is copied or re-archived. If SyncSpace
#  AI says "not configured", this file is the first thing to check.
# ===========================================================================

# ---------------------------------------------------------------------------
#  SyncSpace AI  (REQUIRED for the AI panel — see AI_MODULE.md)
# ---------------------------------------------------------------------------
# Without this, every AI request returns "not configured" and nothing else in
# the app is affected. Get a free key at https://aistudio.google.com/apikey
#
# Format rules — these cause almost every "API key not valid" error:
#   no quotes, no spaces around "=", no trailing space, no leading "#".
GEMINI_API_KEY=AQ.Ab8RN6LP3VRAOPInc7e9sR-EYaxlaLQAkdQRL4ZQVJJnljFOAA

# --- Model tiers (optional) ------------------------------------------------
# Simple work (chat, generate, tests, document) uses FAST; work where being
# wrong costs more than being slow (debug, error, optimize, convert, large
# payloads) uses SMART. Defaults shown — leave commented to use them.
# AI_MODEL_FAST=gemini-3.5-flash-lite
# AI_MODEL_SMART=gemini-3.6-flash

# Pin ONE model for every request, overriding both tiers. Useful only for
# A/B testing a new model; leaving it set makes simple requests slower.
# GEMINI_MODEL=

# --- Thinking level (optional) ---------------------------------------------
# The dominant latency control. Allowed: minimal | low | medium | high.
# AI_THINKING_FAST=minimal
# AI_THINKING_SMART=low

# --- Timeouts and limits (optional) ----------------------------------------
# AI_TIMEOUT_MS=60000
# AI_STALL_TIMEOUT_MS=20000
# AI_RATE_MAX=20
# AI_RATE_WINDOW_MS=60000

# ---------------------------------------------------------------------------
#  Persistence (optional)
# ---------------------------------------------------------------------------
# Without this the backend runs in memory only: workspaces reset on restart.
# MONGO_URI=mongodb://127.0.0.1:27017/syncspace

# Signing secret for session tokens. A random one is generated per start if
# unset, which logs everyone out on every restart. Set it for a stable dev
# session; set it to something long and random for anything deployed.
# JWT_SECRET=

# PORT=5000

# ---------------------------------------------------------------------------
#  Code execution (optional — see EXECUTION.md)
# ---------------------------------------------------------------------------
# Falls back to paiza.io with no account when unset. Fine for a demo.
# EXEC_PROVIDERS=judge0,piston,paiza
# JUDGE0_URL=https://judge0-ce.p.sulu.sh
# JUDGE0_KEY=
# EXEC_RUN_TIMEOUT_MS=8000
# EXEC_RATE_MAX=20
